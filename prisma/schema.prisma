generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Course {
  id              String     @id @default(cuid())
  name            String
  code            String     @unique
  color           String     @default("#577568")
  minPassingGrade Float      @default(3.0)
  grades          Grade[]
  schedules       Schedule[]
  tasks           Task[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([name])
}

model Grade {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  /// Score on the 0-5 grading scale; null until the assessment is evaluated.
  score       Float?
  /// Assessment weight as percentage points of the course total (0-100).
  weight      Float
  evaluatedAt DateTime?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

model Schedule {
  id          String   @id @default(cuid())
  courseId    String
  dayOfWeek   Weekday
  startMinute Int
  endMinute   Int
  location    String?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dayOfWeek, startMinute])
  @@index([courseId])
}

model Task {
  id          String     @id @default(cuid())
  courseId    String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, dueAt])
  @@index([courseId])
}
